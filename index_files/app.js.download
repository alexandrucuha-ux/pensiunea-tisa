// Explain: App entry point for form handling and UI interactions.
document.addEventListener('DOMContentLoaded', function() {
    
    // Reviews Carousel
    if (typeof window.Swiper !== 'undefined') {
        new window.Swiper('.reviews-swiper', {
            slidesPerView: 1,
            spaceBetween: 30,
            loop: true,
            autoplay: {
                delay: 5000,
                disableOnInteraction: false,
            },
            pagination: {
                el: '.swiper-pagination',
                clickable: true,
            },
            breakpoints: {
                768: { slidesPerView: 2 },
                1024: { slidesPerView: 3 }
            }
        });
    }

    // Contact Form Handler
    var contactForm = document.getElementById('contactForm');
    var feedbackDiv = document.getElementById('formFeedback');

    if(contactForm) {
        contactForm.addEventListener('submit', function(e) {
            e.preventDefault();
            
            var submitBtn = contactForm.querySelector('button[type="submit"]');
            var originalBtnText = submitBtn.innerText;
            submitBtn.innerText = "Se trimite...";
            submitBtn.disabled = true;
            
            var fields = [
                { label: 'Nume', value: contactForm.nume.value, type: 'text' },
                { label: 'Email', value: contactForm.email.value, type: 'email' },
                { label: 'Telefon', value: contactForm.telefon.value, type: 'tel' },
                { label: 'Mesaj', value: contactForm.mesaj.value, type: 'textarea' }
            ];

            if(contactForm.dataSosire.value) {
                fields.push({ label: 'Data Sosire', value: contactForm.dataSosire.value, type: 'date' });
            }
            if(contactForm.dataPlecare.value) {
                fields.push({ label: 'Data Plecare', value: contactForm.dataPlecare.value, type: 'date' });
            }

            window.MessagesSystem.submit(fields, contactForm).then(function(r) {
                submitBtn.innerText = originalBtnText;
                submitBtn.disabled = false;
                
                feedbackDiv.classList.remove('hidden', 'bg-red-50', 'text-red-700', 'bg-green-50', 'text-green-700');
                
                if (r.success) {
                    feedbackDiv.classList.add('bg-green-50', 'text-green-700');
                    feedbackDiv.innerText = "Vă mulțumim! Solicitarea a fost trimisă cu succes. Vă vom contacta în curând.";
                    contactForm.reset();
                } else {
                    feedbackDiv.classList.add('bg-red-50', 'text-red-700');
                    feedbackDiv.innerText = "A apărut o eroare: " + (r.error || "Vă rugăm să încercați din nou.");
                }
            });
        });
    }

});